<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do icone adaptativo. O mesmo gradiente dos PNG de aparelho antigo:
     se divergirem, o icone muda de cara conforme a versao do Android. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#7B60AC"
        android:centerColor="#5B3E8E"
        android:endColor="#432C6B" />
</shape>
