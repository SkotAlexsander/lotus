<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- UMA permissão só: INTERNET, e ela existe por UM motivo — o mapa de
         ruas de verdade (MapLibre + OpenFreeMap).

         Ela NÃO estava aqui até 23/08. Foi acrescentada quando o mapa real
         entrou, porque um aplicativo que mostra um mapa diferente do site
         confunde quem está testando os dois.

         O que continua valendo:
           · as 12 terapeutas são ficção num arquivo JavaScript, dentro do pacote
           · as fontes estão embutidas — tipografia não depende da rede
           · nada do aparelho sai: não há login, não há envio, não há análise
           · sem internet o app CAI no mapa desenhado e continua inteiro

         O que NÃO é pedido, de propósito: localização, câmera, contatos,
         armazenamento, notificação. O botão do WhatsApp não precisa de nenhuma
         delas — ele entrega o link ao Android, e quem acessa a rede é o
         WhatsApp. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/TemaMapaHolistico"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
