<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- UMA permissão só: INTERNET, e ela existe por UM motivo — o mapa de
         ruas de verdade (MapLibre + OpenFreeMap).

         Ela NÃO estava aqui até 23/08. Foi acrescentada quando o mapa real
         entrou, porque um aplicativo que mostra um mapa diferente do site
         confunde quem está testando os dois.

         O que continua valendo:
           · as 12 terapeutas são ficção num arquivo JavaScript, dentro do pacote
           · as fontes estão embutidas — tipografia não depende da rede
           · nada do aparelho sai: não há login, não há envio, não há análise
           · sem internet o app CAI no mapa desenhado e continua inteiro

         O que NÃO é pedido, de propósito: localização, câmera, contatos,
         armazenamento, notificação. O botão do WhatsApp não precisa de nenhuma
         delas — ele entrega o link ao Android, e quem acessa a rede é o
         WhatsApp. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- LOCALIZAÇÃO: é a pergunta que o app existe para responder — "quem
         atende PERTO DE MIM". Sem ela o ponto azul seria um lugar inventado.

         COARSE é declarada junto porque o Android 12+ deixa a pessoa escolher
         "localização aproximada" na hora de permitir; sem as duas declaradas,
         essa opção nem aparece e ela fica entre dar a rua exata ou negar tudo.

         ⚠️ A posição NUNCA é gravada: nem em banco, nem em arquivo, nem em log.
         Ela é usada em memória para centralizar o mapa e ordenar a lista por
         distância. Fechou o app, acabou. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/TemaMapaHolistico"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
